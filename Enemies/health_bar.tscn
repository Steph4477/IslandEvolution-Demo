[sub_resource type="GDScript" id="GDScript_msolp"]
script/source = "extends Node2D


# --- Nodes ---
@onready var bar = $ProgressBar
@onready var hp_label = $HpLabel


func _ready():
	update_label()


# ============================================================================
#                               SYNC MAX HP
# ============================================================================
func set_max(v):
	bar.max_value = v
	bar.value = v
	update_label()


# ============================================================================
#                               UPDATE VALUE
# ============================================================================
func set_value(v):
	bar.value = clamp(v, 0, bar.max_value)
	update_label()


# ============================================================================
#                               UPDATE LABEL
# ============================================================================
func update_label():
	hp_label.text = str(int(bar.value)) + \" / \" + str(int(bar.max_value))
"

